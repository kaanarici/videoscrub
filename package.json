{
  "name": "videoscrub",
  "version": "0.2.0",
  "description": "Ask your coding agent questions about a video file or link.",
  "license": "MIT",
  "homepage": "https://github.com/kaanarici/videoscrub",
  "repository": "github:kaanarici/videoscrub",
  "type": "module",
  "bin": {
    "videoscrub": "src/server.ts"
  },
  "files": ["src", "!src/*.test.ts", "skills", "docs", "plugin.json", "mcp.json", ".claude-plugin", ".codex-plugin"],
  "scripts": {
    "start": "bun run src/server.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jimp": "^1.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7"
  }
}
